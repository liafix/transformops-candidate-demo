# Runtime PostgreSQL connection. For Neon/Vercel use the pooled connection URL.
# Never commit a real password or connection string.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLED-HOST/neondb?sslmode=require"

# Prisma CLI connection used for migrations. For Neon use the direct (non-pooler) host.
# If no separate direct URL is needed, this may be the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require"

# Seeding deletes all TransformOps demo rows before recreating deterministic
# synthetic fixtures. Enable only for an isolated TransformOps demo database.
DEMO_SEED_RESET_ALLOWED="false"
